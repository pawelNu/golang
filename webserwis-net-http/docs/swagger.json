                },
                "name": {
                    "description": "Imię użytkownika",
                    "type": "string",
                    "example": "Jan Kowalski"
                }
            }
        },
        "model.ResponseBody": {
            "type": "object",
            "properties": {
                "message": {
                    "description": "Komunikat do użytkownika",
                    "type": "string",
