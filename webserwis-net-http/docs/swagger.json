                    "application/json"
                ],
                "tags": [
                    "tickets"
                ],
                "summary": "Get ticket history by ticket id",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Ticket Id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
